#!/bin/sh
# Quake (TyrQuake-Miyoo) for the Miyoo Mini Plus (OnionOS), without RetroArch
# https://github.com/ksielick/tyrquake-miyoo (branch standalone)
GameName="Quake (TyrQuake-Miyoo)"
GameDir="TyrQuake-Miyoo"
GameExecutable="launch.sh"
# the program itself: the shortcut always shows; launch.sh tells if Quake's data is missing
GameDataFile="tqrun"

KillAudioserver=0
PerformanceMode=1

Arguments=""

cd "/mnt/SDCARD/Roms/PORTS/Games/$GameDir"
/mnt/SDCARD/Emu/PORTS/launch_standalone.sh "$GameName" "$GameDir" "$GameExecutable" "$Arguments" "$GameDataFile" "$KillAudioserver" "$PerformanceMode"
